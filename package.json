{
  "name": "loggily",
  "version": "0.7.0",
  "description": "Debugs, logs, and spans — one API. Disabled logs skip argument evaluation entirely via optional chaining. ~3KB, zero dependencies.",
  "keywords": [
    "browser",
    "bun",
    "debug",
    "json-logger",
    "logger",
    "logging",
    "namespace",
    "node",
    "observability",
    "optional-chaining",
    "spans",
    "structured-logging",
    "tracing",
    "typescript",
    "zero-dependency"
  ],
  "homepage": "https://beorn.codes/loggily/",
  "bugs": {
    "url": "https://github.com/beorn/loggily/issues"
  },
  "license": "MIT",
  "author": "Bjørn Stabell <bjorn@stabell.org>",
  "repository": {
    "type": "git",
    "url": "https://github.com/beorn/loggily.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./worker": "./src/worker.ts",
    "./metrics": "./src/metrics.ts",
    "./context": "./src/context.ts"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs"
      },
      "./worker": {
        "types": "./dist/worker.d.mts",
        "import": "./dist/worker.mjs"
      },
      "./metrics": {
        "types": "./dist/metrics.d.mts",
        "import": "./dist/metrics.mjs"
      },
      "./context": {
        "types": "./dist/context.d.mts",
        "import": "./dist/context.mjs"
      }
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "bunx --bun vitest run",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "tsdown": "^0.21.7",
    "vitepress": "^1.6.4",
    "vitepress-enrich": "^0.4.0",
    "vitepress-plugin-llms": "^1.12.0",
    "vitest": "^4.1.1"
  },
  "tsdown": {
    "clean": true,
    "dts": true,
    "entry": [
      "src/index.ts",
      "src/worker.ts",
      "src/metrics.ts",
      "src/context.ts"
    ],
    "format": "esm"
  },
  "engines": {
    "bun": ">=1.0",
    "node": ">=23.6.0"
  }
}
